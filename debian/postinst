#!/bin/sh
set -e

PACKAGE_NAME="facer"
PACKAGE_VERSION="1.20260725"
SERVICE_NAME="shipsar-acer-rgb.service"

case "$1" in
    configure)
        echo "[*] Configuring Shipsar Acer Predator Turbo & RGB Control..."

        # 1. Blacklist stock acer_wmi module
        echo "blacklist acer_wmi" > /etc/modprobe.d/blacklist-acer-wmi.conf

        # 2. Create udev rules
        echo 'KERNEL=="acer-gkbbl*", MODE="0666"' > /etc/udev/rules.d/99-acer-gkbbl.rules
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
            udevadm trigger || true
        fi

        # 3. Add & Install kernel module via DKMS
        if command -v dkms >/dev/null 2>&1; then
            echo "[*] Registering module with DKMS..."
            dkms remove ${PACKAGE_NAME}/${PACKAGE_VERSION} --all 2>/dev/null || true
            dkms add -m ${PACKAGE_NAME} -v ${PACKAGE_VERSION} || true
            echo "[*] Building and installing DKMS kernel driver..."
            dkms build -m ${PACKAGE_NAME} -v ${PACKAGE_VERSION} || true
            dkms install -m ${PACKAGE_NAME} -v ${PACKAGE_VERSION} || true
        else
            echo "[!] Warning: dkms command not found. Kernel module could not be registered automatically."
        fi

        # 4. Enable and start systemd service
        if command -v systemctl >/dev/null 2>&1 && systemctl is-system-running >/dev/null 2>&1; then
            systemctl daemon-reload || true
            systemctl enable ${SERVICE_NAME} || true
            systemctl start ${SERVICE_NAME} --no-block || true
        fi

        echo "[*] Installation complete!"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
